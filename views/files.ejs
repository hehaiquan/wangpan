<%- include('partials/header') %>
<section class="page-heading"><div><span class="eyebrow">SHARED FILES</span><h1><%= listing.relative ? listing.breadcrumbs.at(-1).name : '文件空间' %></h1><p>在这里找到所需文件，让协作更简单。</p></div><a class="button secondary" href="<%= linkTo('/files', { path: listing.relative, q: query, page: listing.page }) %>"><%- include('partials/icon', { name: 'refresh' }) %>刷新列表</a></section>
<div class="stats-grid">
  <div class="stat-card"><span class="stat-icon teal"><%- include('partials/icon', { name: 'file' }) %></span><div><span>当前<%= query ? '筛选' : '目录' %>文件</span><strong><%= listing.fileCount %><small>个</small></strong></div></div>
  <div class="stat-card"><span class="stat-icon amber"><%- include('partials/icon', { name: 'folder' }) %></span><div><span>当前<%= query ? '筛选' : '目录' %>文件夹</span><strong><%= listing.folderCount %><small>个</small></strong></div></div>
  <div class="stat-card"><span class="stat-icon blue"><%- include('partials/icon', { name: 'box' }) %></span><div><span>当前<%= query ? '筛选' : '目录' %>文件大小</span><strong class="size-stat"><%= formatSize(listing.fileBytes) %></strong></div></div>
</div>
<section class="panel">
  <div class="panel-toolbar">
    <nav class="breadcrumbs" aria-label="文件路径"><a href="/files"><%- include('partials/icon', { name: 'folder' }) %>全部文件</a><% for (const crumb of listing.breadcrumbs) { %><span class="breadcrumb-chevron">/</span><a href="<%= linkTo('/files', { path: crumb.relative }) %>"><%= crumb.name %></a><% } %></nav>
    <form method="get" action="/files" class="search-form"><input type="hidden" name="path" value="<%= listing.relative %>"><label class="sr-only" for="file-query">搜索当前目录</label><%- include('partials/icon', { name: 'search' }) %><input id="file-query" name="q" value="<%= query %>" maxlength="128" placeholder="搜索当前目录"><button class="search-submit" type="submit">搜索</button></form>
  </div>
  <% if (listing.relative || query) { %><div class="list-context"><% if (listing.relative) { %><a href="<%= linkTo('/files', { path: listing.parent }) %>" class="text-link"><%- include('partials/icon', { name: 'back' }) %>返回上一级</a><% } %><% if (query) { %><span>“<%= query %>” 的搜索结果 <a class="text-link" href="<%= linkTo('/files', { path: listing.relative }) %>">清除筛选</a></span><% } %></div><% } %>
  <div class="table-scroll"><table class="data-table file-table"><thead><tr><th class="name-column">文件名称</th><th>文件大小</th><th>修改时间</th><th class="action-column">操作</th></tr></thead><tbody>
  <% for (const item of listing.items) { %><tr>
    <td><div class="file-name-cell"><span class="file-icon <%= item.isDirectory ? 'folder-icon' : 'document-icon' %>"><%- include('partials/icon', { name: item.isDirectory ? 'folder' : 'file' }) %></span><div class="file-name-text"><% if (item.isDirectory) { %><a class="file-name" href="<%= linkTo('/files', { path: item.relative }) %>"><%= item.name %></a><% } else { %><span class="file-name"><%= item.name %></span><% } %><small><%= item.isDirectory ? '文件夹' : item.name.includes('.') ? item.name.split('.').pop().toUpperCase().slice(0, 12) + ' 文件' : '文件' %></small></div></div></td>
    <td class="muted"><%= item.isDirectory ? '—' : formatSize(item.size) %></td><td class="time-cell"><%= formatTime(item.modified) %></td>
    <td><% if (item.isDirectory) { %><a class="row-action folder-action" href="<%= linkTo('/files', { path: item.relative }) %>">打开<%- include('partials/icon', { name: 'arrow' }) %></a><% } else { %><a class="row-action" href="<%= linkTo('/download', { path: item.relative }) %>" aria-label="下载 <%= item.name %>"><%- include('partials/icon', { name: 'download' }) %>下载</a><% } %></td>
  </tr><% } %>
  <% if (!listing.items.length) { %><tr><td colspan="4"><div class="empty-state"><span class="empty-icon"><%- include('partials/icon', { name: query ? 'search' : 'folder' }) %></span><h2><%= query ? '没有找到匹配的文件' : '这个文件夹还是空的' %></h2><p><%= query ? '试试其他名称，或清除筛选查看全部文件。' : '管理员放入文件后，刷新即可在这里查看。' %></p></div></td></tr><% } %>
  </tbody></table></div>
  <%- include('partials/pagination', { total: listing.total, page: listing.page, pages: listing.pages, route: '/files', parameters: { path: listing.relative, q: query } }) %>
</section>
<%- include('partials/footer') %>
