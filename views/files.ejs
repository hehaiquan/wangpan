<%- include('partials/header') %>
<section class="page-heading"><div><span class="eyebrow">SHARED FILES</span><h1><%= listing.relative ? listing.breadcrumbs.at(-1).name : '文件空间' %></h1><p>浏览、查找和下载共享文件。</p></div><a class="button secondary" href="<%= linkTo('/files', { path: listing.relative, q: query, page: listing.page }) %>"><%- include('partials/icon', { name: 'refresh' }) %>刷新列表</a></section>
<div class="stats-grid">
  <div class="stat-card"><span class="stat-icon teal"><%- include('partials/icon', { name: 'file' }) %></span><div><span><span class="stat-scope">当前<%= query ? '筛选' : '目录' %></span>文件</span><strong><%= listing.fileCount %><small>个</small></strong></div></div>
  <div class="stat-card"><span class="stat-icon amber"><%- include('partials/icon', { name: 'folder' }) %></span><div><span><span class="stat-scope">当前<%= query ? '筛选' : '目录' %></span>文件夹</span><strong><%= listing.folderCount %><small>个</small></strong></div></div>
  <div class="stat-card"><span class="stat-icon blue"><%- include('partials/icon', { name: 'box' }) %></span><div><span><span class="stat-scope">当前<%= query ? '筛选' : '目录' %></span>文件大小</span><strong class="size-stat"><%= formatSize(listing.fileBytes) %></strong></div></div>
</div>
<section class="panel">
  <div class="panel-toolbar">
    <nav class="breadcrumbs" aria-label="文件路径"><a href="/files" <%- !listing.relative ? 'aria-current="page"' : '' %>><%- include('partials/icon', { name: 'folder' }) %>全部文件</a><% for (const crumb of listing.breadcrumbs) { %><span class="breadcrumb-chevron">/</span><a href="<%= linkTo('/files', { path: crumb.relative }) %>" <%- crumb.relative === listing.relative ? 'aria-current="page"' : '' %>><%= crumb.name %></a><% } %></nav>
    <form method="get" action="/files" class="search-form"><input type="hidden" name="path" value="<%= listing.relative %>"><label class="sr-only" for="file-query">搜索当前目录及子目录</label><%- include('partials/icon', { name: 'search' }) %><input id="file-query" name="q" value="<%= query %>" maxlength="128" placeholder="搜索当前目录及子目录"><button class="search-submit" type="submit">搜索</button></form>
  </div>
  <% if (listing.relative || query) { %><div class="list-context"><% if (listing.relative) { %><a href="<%= linkTo('/files', { path: listing.parent }) %>" class="text-link"><%- include('partials/icon', { name: 'back' }) %>返回上一级</a><% } %><% if (query) { %><span>“<%= query %>” 的搜索结果（包含子目录） <a class="text-link" href="<%= linkTo('/files', { path: listing.relative }) %>">清除筛选</a></span><% } %></div><% } %>
  <% if (listing.skippedDirectories) { %><p class="list-context">有 <%= listing.skippedDirectories %> 个子目录无法读取或已不存在，搜索结果未包含其内容。</p><% } %>
  <div class="table-scroll"><table class="data-table file-table"><caption class="sr-only"><%= query ? '当前目录及子目录的搜索结果' : '当前目录的文件和文件夹' %></caption><thead><tr><th scope="col" class="name-column">文件名称</th><th scope="col" class="size-column">文件大小</th><th scope="col">修改时间</th><th scope="col" class="action-column">操作</th></tr></thead><tbody>
  <% for (const item of listing.items) { %><tr>
    <td><div class="file-name-cell"><span class="file-icon <%= item.isDirectory ? 'folder-icon' : 'document-icon' %>"><%- include('partials/icon', { name: item.isDirectory ? 'folder' : 'file' }) %></span><div class="file-name-text"><% if (item.isDirectory) { %><a class="file-name" href="<%= linkTo('/files', { path: item.relative }) %>"><%= item.name %></a><% } else { %><span class="file-name"><%= item.name %></span><% } %><small><%= item.isDirectory ? '文件夹' : item.name.includes('.') ? item.name.split('.').pop().toUpperCase().slice(0, 12) + ' 文件' : '文件' %></small><% if (query) { %><small class="file-result-path">路径：<%= item.relative %></small><% } %></div></div></td>
    <td class="muted file-size-cell <%= item.isDirectory ? 'folder-size-cell' : '' %>"><%= item.isDirectory ? '—' : formatSize(item.size) %></td><td class="time-cell"><%= formatTime(item.modified) %></td>
    <td class="file-actions-cell"><div class="file-actions"><% if (item.isDirectory) { %><a class="row-action folder-action" aria-label="打开文件夹 <%= item.name %>" href="<%= linkTo('/files', { path: item.relative }) %>">打开<%- include('partials/icon', { name: 'arrow' }) %></a><% } else { %><a class="row-action" href="<%= linkTo('/download', { path: item.relative }) %>" aria-label="下载 <%= item.name %>"><%- include('partials/icon', { name: 'download' }) %>下载</a><% } %><% if (currentUser.role === 'admin') { %><button type="button" class="text-button danger-text" data-delete-path="<%= item.relative %>" data-delete-directory="<%= item.isDirectory %>" aria-label="删除 <%= item.name %>">删除</button><% } %></div></td>
  </tr><% } %>
  <% if (!listing.items.length) { %><tr><td colspan="4" class="empty-cell"><div class="empty-state"><span class="empty-icon"><%- include('partials/icon', { name: query ? 'search' : 'folder' }) %></span><h2><%= query ? '没有找到匹配的文件' : '这个文件夹还是空的' %></h2><p><%= query ? '试试其他名称，或清除筛选查看全部文件。' : '管理员放入文件后，刷新即可在这里查看。' %></p><% if (query) { %><a class="button secondary" href="<%= linkTo('/files', { path: listing.relative }) %>">查看全部文件</a><% } %></div></td></tr><% } %>
  </tbody></table></div>
  <%- include('partials/pagination', { total: listing.total, page: listing.page, pages: listing.pages, route: '/files', parameters: { path: listing.relative, q: query } }) %>
</section>
<% if (currentUser.role === 'admin') { %>
<dialog id="delete-dialog" class="modal" aria-labelledby="delete-title" aria-describedby="delete-description delete-target">
  <div class="modal-heading"><h2 id="delete-title">确认删除</h2><button class="icon-button" type="button" data-close-dialog aria-label="关闭"><%- include('partials/icon', { name: 'close' }) %></button></div>
  <p id="delete-target" class="delete-target"></p><p id="delete-description" class="muted"></p>
  <form id="delete-form" action="/admin/files/delete" method="post" class="stack-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="path" value="">
    <input type="hidden" name="returnPath" value="<%= listing.relative %>"><input type="hidden" name="q" value="<%= query %>"><input type="hidden" name="page" value="<%= listing.page %>">
    <div class="modal-actions"><button class="button secondary" type="button" data-close-dialog autofocus>取消</button><button class="button danger-button" type="submit">确认删除</button></div>
  </form>
</dialog>
<% } %>
<%- include('partials/footer') %>
