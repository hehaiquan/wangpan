# 相对路径以项目目录为基准；Linux 生产部署建议配置绝对路径。
FILE_ROOT=./storage
SQLITE_PATH=./data/wangpan.sqlite
HOST=127.0.0.1
PORT=3000
# npm run setup 会生成随机密钥；手动配置时至少使用 32 个字符。
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_HOURS=8
# 默认直接访问；同机 Nginx 代理时设置为 loopback。
TRUST_PROXY=false
# 本地 HTTP 为 false，生产 HTTPS 为 true。
COOKIE_SECURE=false
NODE_ENV=development
