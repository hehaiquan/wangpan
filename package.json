{
  "name": "wangpan",
  "version": "1.0.0",
  "private": true,
  "description": "使用 SQLite 保存账号和审计记录的轻量共享网盘",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
